CompileFlags:
  CompilationDatabase: packages/duckdb-fork/.cache/clangd
  Add: -Wno-unqualified-std-cast-call

# Keep this list in sync with tidy-check-diff exclusions in the Makefile.
---
If:
  PathMatch: \b(tools|extension|test|benchmark|third_party|src/common/adbc|src/main/capi)/.*
Diagnostics:
  ClangTidy:
    Remove: '*'
